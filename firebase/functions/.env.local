# Loaded only by the Firebase Emulator Suite. Never used for deployment.
# The emulator-only test provider returns synthetic, clearly labelled results without Google calls.
PROVIDER_MODE=emulator-fake
ENFORCE_APP_CHECK=false
MAX_ELIGIBLE_STOPS=200
DAILY_GEOCODES_PER_USER=400
DAILY_OPTIMIZATIONS_PER_USER=25
DAILY_SHIPMENTS_PER_USER=2000
MONTHLY_GEOCODE_BUDGET=9000
MONTHLY_SHIPMENT_BUDGET=4500
DAILY_SUGGESTIONS_PER_USER=500
MONTHLY_SUGGESTION_BUDGET=9000
