// Copy to Config/Secrets.xcconfig (git-ignored) and fill in.
PP_DEVELOPMENT_TEAM = ABCDE12345
PP_BUNDLE_ID = ca.yourname.parcelpilot
// YES only with a paid Apple Developer Program membership (Sign in with Apple + App Attest).
PP_APPLE_DEVELOPER_PROGRAM = NO
GOOGLE_MAPS_IOS_API_KEY = AIza...restricted-to-your-bundle-id
// REVERSED_CLIENT_ID from GoogleService-Info.plist, e.g. com.googleusercontent.apps.1234-abcd
GOOGLE_REVERSED_CLIENT_ID =
